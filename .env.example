# Required local roots. Keep outputs outside the repository when possible.
AESTHETIC_DATA_ROOT=/path/to/aesthetic-data
AESTHETIC_MODEL_ROOT=/path/to/aesthetic-models
AESTHETIC_OUTPUT_ROOT=/path/to/aesthetic-outputs
AESTHETIC_METRIC_MODEL_ROOT=/path/to/metric-models
AESTHETIC_JAVA=/path/to/java8/bin/java

# Generated locally by the preparation scripts; files are not redistributed.
ARTIMUSE_CONTEXT_FILE=/path/to/artimuse_16shot_context.json
UNIAA_1SHOT_CONTEXT_FILE=/path/to/uniaa_fixed_first_context.json
